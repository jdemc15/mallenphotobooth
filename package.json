{
  "name": "photobooth-react-kiosk",
  "private": true,
  "scripts": {
    "dev": "concurrently -k \"npm:server\" \"npm:client\"",
    "client": "npm --prefix client run dev",
    "server": "node --watch server/index.js",
    "build": "npm --prefix client run build",
    "start": "node server/index.js"
  },
  "dependencies": {
    "express": "^5.1.0",
    "multer": "^2.0.2"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}